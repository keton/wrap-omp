#!/usr/bin/env bash
# wrap-omp: run oh-my-pi inside a bubblewrap sandbox.
#
# Override the omp binary:
#   OMP_BIN=/path/to/omp ./omp-bwrap
#
# Optional config file (JSON with comments):
#   ~/.config/wrap-omp.conf   (preferred)
#   ~/wrap-omp.conf           (fallback)
#
# Config keys:
#   "env"                — extra env var names to pull from host into sandbox
#   "set_env"            — literal NAME: value pairs set inside the sandbox,
#                          never read from the host
#   "writeable_mounts"   — extra paths to --bind (read-write)
#   "read_only_mounts"   — extra paths to --ro-bind
#   "try_mount_writeable", "try_mount_read_only"
#                        — same, but a missing path is silently skipped
#   "dev_mounts"         — extra paths to --dev-bind (writeable and may
#                          contain device nodes), e.g. /dev/dri for GPU access
#   "shared_temp"        — true to back the sandbox /tmp with a fresh
#                          directory under the host /tmp instead of a tmpfs,
#                          so the host can inspect what the sandbox wrote.
#                          Its host path is exported as REALTEMP so a host-side
#                          editor shim (omp-code) can remap /tmp paths
#   "shared_temp_cleanup" — true to delete that directory when the sandbox exits
#   "dbus"               — per-bus xdg-dbus-proxy policy args, e.g.
#                          {"system": ["--talk=org.bluez"]}; without an entry
#                          the sandbox has no access to that bus
#   "clipboard_bridge"   — true to serve image/png from the host clipboard
#                          through a read-only host-side broker. Wayland hosts
#                          use wl-paste; WSL hosts read the Windows clipboard
#                          with powershell.exe, so the sandbox needs neither
#                          /mnt/c nor /run/WSL. Requires omp-clip-shim and
#                          omp-clip-broker next to this script.

set -euo pipefail

OMP_BIN="${OMP_BIN:-omp}"
WORKDIR="${WORKDIR:-$(pwd)}"
WORKDIR="$(cd "$WORKDIR" && pwd -P)"
HOME_REAL="$(cd "${HOME}" && pwd -P)"
USER="${USER:-$(id -un)}" # cron, systemd and docker do not always export USER

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------
if ! command -v bwrap &>/dev/null; then
    echo "wrap-omp: error: bubblewrap sandbox tool bwrap is required but not found on PATH" >&2
    exit 1
fi

if [[ ! -x "${OMP_BIN}" ]] && ! command -v "${OMP_BIN}" &>/dev/null; then
    echo "wrap-omp: error: ${OMP_BIN} not found or not executable" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Config file (optional) — extra mounts and env vars beyond the hardcoded set
# ---------------------------------------------------------------------------
EXTRA_ENV_VARS=()
SET_ENV_PAIRS=()
EXTRA_BIND_MOUNTS=()
EXTRA_RO_MOUNTS=()
TRY_BIND_MOUNTS=()
TRY_RO_MOUNTS=()
DEV_MOUNTS=()
DBUS_SYSTEM_ARGS=()
DBUS_SESSION_ARGS=()
CLIP_BRIDGE=false
SHARED_TEMP=false
SHARED_TEMP_CLEANUP=false

OMP_CONF=""
for dir in "${HOME}/.config" "${HOME}"; do
    if [[ -f "${dir}/wrap-omp.conf" ]]; then
        OMP_CONF="${dir}/wrap-omp.conf"
        break
    fi
done

if [[ -n "${OMP_CONF}" ]]; then
    if ! command -v jq &>/dev/null; then
        echo "wrap-omp: error: jq is required to parse ${OMP_CONF}" >&2
        exit 1
    fi

    # Strip // comments, then read every value in one jq pass as
    # "key<TAB>value<NUL>" records.
    # shortcut: "//" inside a string is stripped too, so values must not contain it
    CLEAN="$(sed 's|//.*$||' "${OMP_CONF}")"

    if ! printf '%s' "$CLEAN" | jq empty 2>/dev/null; then
        echo "wrap-omp: error: invalid JSON in ${OMP_CONF}" >&2
        exit 1
    fi

    while IFS=$'\t' read -r -d '' key val; do
        case "${key}" in
            env) EXTRA_ENV_VARS+=("${val}") ;;
            badset)
                echo "wrap-omp: error: \"set_env\" must be an object, not ${val}" >&2
                exit 1
                ;;
            setenv)
                IFS= read -r -d '' name
                IFS= read -r -d '' type
                IFS= read -r -d '' val
                if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                    echo "wrap-omp: error: invalid \"set_env\" name: ${name}" >&2
                    exit 1
                fi
                case "${type}" in
                    string | number | boolean) ;;
                    *)
                        echo "wrap-omp: error: \"set_env\" ${name} must be a string, number or boolean" >&2
                        exit 1
                        ;;
                esac
                SET_ENV_PAIRS+=("${name}=${val}")
                ;;
            rw) EXTRA_BIND_MOUNTS+=("${val/#\~/$HOME}") ;;
            ro) EXTRA_RO_MOUNTS+=("${val/#\~/$HOME}") ;;
            rw-try) TRY_BIND_MOUNTS+=("${val/#\~/$HOME}") ;;
            ro-try) TRY_RO_MOUNTS+=("${val/#\~/$HOME}") ;;
            dev) DEV_MOUNTS+=("${val/#\~/$HOME}") ;;
            dbus-system) DBUS_SYSTEM_ARGS+=("${val}") ;;
            dbus-session) DBUS_SESSION_ARGS+=("${val}") ;;
            sharedtmp) SHARED_TEMP=true ;;
            sharedtmpcleanup) SHARED_TEMP_CLEANUP=true ;;
            clip) CLIP_BRIDGE=true ;;
        esac
    done < <(printf '%s' "$CLEAN" | jq -j '
        def emit($k): .[]? | select(. != "") | "\($k)\t\(.)\u0000";
        ((.env // []) | emit("env")),
        ((.set_env // {}) |
            if type != "object" then "badset\t\(type)\u0000"
            else to_entries[] |
                select(.value != null) |
                "setenv\u0000\(.key)\u0000\(.value | type)\u0000\(.value | tostring)\u0000"
            end),
        ((.writeable_mounts // []) | emit("rw")),
        ((.read_only_mounts // []) | emit("ro")),
        ((.try_mount_writeable // []) | emit("rw-try")),
        ((.try_mount_read_only // []) | emit("ro-try")),
        ((.dev_mounts // []) | emit("dev")),
        ((.dbus.system // []) | emit("dbus-system")),
        ((.dbus.session // []) | emit("dbus-session")),
        (if (.shared_temp // false) == true then "sharedtmp\t\u0000" else empty end),
        (if (.shared_temp_cleanup // false) == true then "sharedtmpcleanup\t\u0000" else empty end),
        (if (.clipboard_bridge // false) == true then "clip\t\u0000" else empty end)
    ')
fi

# Expand simple '*'/'?'/'[' globs in a mount list ('~' is expanded at parse
# time). A pattern that matches nothing selects nothing.
expand_mounts() {
    local -n out="$1"
    local -a patterns=("${@:2}")
    local -a matches
    local p
    out=()
    for p in "${patterns[@]}"; do
        if [[ "$p" == *[\*\?\[]* ]]; then
            shopt -s nullglob
            # shellcheck disable=SC2206 # intentional: unquoted glob expansion
            matches=($p)
            shopt -u nullglob
            out+=("${matches[@]}")
        else
            out+=("$p")
        fi
    done
}

expand_mounts EXTRA_RO_MOUNTS "${EXTRA_RO_MOUNTS[@]}"
expand_mounts EXTRA_BIND_MOUNTS "${EXTRA_BIND_MOUNTS[@]}"
expand_mounts TRY_RO_MOUNTS "${TRY_RO_MOUNTS[@]}"
expand_mounts TRY_BIND_MOUNTS "${TRY_BIND_MOUNTS[@]}"
expand_mounts DEV_MOUNTS "${DEV_MOUNTS[@]}"

# ---------------------------------------------------------------------------
# D-Bus proxies: one filtered xdg-dbus-proxy per configured bus, socket bound
# into the sandbox. Concurrent wrap-omp runs get separate mktemp dirs.
# ---------------------------------------------------------------------------
BWRAP_PID=""
WATCHDOG_PID=""
DBUS_PROXY_DIR=""
DBUS_PROXY_PIDS=()
CLIP_DIR=""
CLIP_PID=""
CLIP_SHIM=""
CLIP_BROKER=""
SHARED_TMP=""
SHARED_TMP_CLEAN=""

cleanup() {
    local pid
    if [[ -n "${WATCHDOG_PID}" ]]; then
        kill "${WATCHDOG_PID}" 2>/dev/null || true
    fi
    if [[ -n "${BWRAP_PID}" ]]; then
        kill "${BWRAP_PID}" 2>/dev/null || true
    fi
    for pid in "${DBUS_PROXY_PIDS[@]}"; do
        kill "${pid}" 2>/dev/null || true
    done
    if [[ -n "${CLIP_PID}" ]]; then
        kill "${CLIP_PID}" 2>/dev/null || true
    fi
    if [[ -n "${DBUS_PROXY_DIR}" ]]; then
        rm -rf "${DBUS_PROXY_DIR}"
    fi
    if [[ -n "${CLIP_DIR}" ]]; then
        rm -rf "${CLIP_DIR}"
    fi
    if [[ -n "${SHARED_TMP_CLEAN}" ]]; then
        rm -rf "${SHARED_TMP_CLEAN}"
    fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

wait_for_socket() {
    local sock="$1" pid="$2" what="$3"
    for _ in {1..100}; do
        [[ -S "${sock}" ]] && return 0
        if ! kill -0 "${pid}" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    echo "wrap-omp: error: ${what} failed to start" >&2
    exit 1
}

# SIGKILL of this script skips the EXIT trap. The watcher is not a target when
# only this pid is killed, so it stops the helpers and removes their dirs after
# the fact. cleanup() kills it on every other exit path.
process_alive() {
    local stat
    read -r stat 2>/dev/null < "/proc/$1/stat" || return 1
    stat="${stat#*) }" # comm is parenthesised and may contain spaces
    [[ "${stat:0:1}" != [ZX] ]]
}

start_watchdog() {
    local parent="$$" pid
    (
        while process_alive "${parent}"; do
            sleep 0.5
        done
        for pid in "${HELPER_PIDS[@]}"; do
            kill "${pid}" 2>/dev/null || true
        done
        rm -rf "${DBUS_PROXY_DIR}" "${CLIP_DIR}" "${SHARED_TMP_CLEAN}"
    ) </dev/null >/dev/null 2>&1 &
    WATCHDOG_PID=$!
}

start_dbus_proxy() {
    local bus="$1" addr="$2" sock pid
    shift 2

    if [[ -z "${DBUS_PROXY_DIR}" ]]; then
        DBUS_PROXY_DIR="$(mktemp -d /tmp/wrap-omp-dbus.XXXXXX)"
    fi

    sock="${DBUS_PROXY_DIR}/${bus}"
    xdg-dbus-proxy "${addr}" "${sock}" --filter "$@" &
    pid="$!"
    DBUS_PROXY_PIDS+=("${pid}")

    wait_for_socket "${sock}" "${pid}" "dbus proxy for ${bus} bus (${addr})"
}

start_clip_broker() {
    local self_dir mode tool what
    self_dir="$(dirname "$(readlink -f "$0")")"
    CLIP_SHIM="${self_dir}/omp-clip-shim"
    CLIP_BROKER="${self_dir}/omp-clip-broker"

    if ! command -v python3 &>/dev/null; then
        echo "wrap-omp: error: python3 is required for \"clipboard_bridge\"" >&2
        exit 1
    fi

    # On WSL the host runs powershell.exe through interop; the sandbox never
    # sees /mnt/c and never runs a Windows binary itself.
    if [[ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]]; then
        mode="wsl"
        tool="$(command -v powershell.exe || true)"
        what="powershell.exe (WSL interop)"
    else
        mode="wayland"
        tool="$(command -v wl-paste || true)"
        what="wl-paste"
    fi
    if [[ "${tool}" != /* ]]; then
        echo "wrap-omp: error: \"clipboard_bridge\" requires ${what} on PATH" >&2
        exit 1
    fi

    if [[ ! -x "${CLIP_SHIM}" || ! -f "${CLIP_BROKER}" ]]; then
        echo "wrap-omp: error: ${CLIP_SHIM} and ${CLIP_BROKER} must be installed next to wrap-omp" >&2
        exit 1
    fi

    if [[ "${mode}" == "wayland" && -z "${WAYLAND_DISPLAY:-}" ]]; then
        echo "wrap-omp: warning: \"clipboard_bridge\" is enabled but the host has no WAYLAND_DISPLAY" >&2
    fi

    CLIP_DIR="$(mktemp -d /tmp/wrap-omp-clip.XXXXXX)"

    # omp spawns a bare `wl-paste`; the shim is that name, found through PATH
    install -m 0755 "${CLIP_SHIM}" "${CLIP_DIR}/wl-paste"

    python3 "${CLIP_BROKER}" "${CLIP_DIR}/broker.sock" "${mode}" "${tool}" &
    CLIP_PID=$!

    wait_for_socket "${CLIP_DIR}/broker.sock" "${CLIP_PID}" "clipboard broker"
}

if [[ ${#DBUS_SYSTEM_ARGS[@]} -gt 0 || ${#DBUS_SESSION_ARGS[@]} -gt 0 ]]; then
    if ! command -v xdg-dbus-proxy &>/dev/null; then
        echo "wrap-omp: error: xdg-dbus-proxy is required for \"dbus\" config but not found on PATH" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Host filesystem shape
# Don't hardcode Fedora's usr-merge flavor. Recreate what the host has: a
# top-level bin/sbin/lib/lib64 that is a symlink stays a symlink (its target
# lives under the already mounted /usr); a real split directory is bound
# read-only. Fedora maps /lib64 -> usr/lib64, Arch maps it to usr/lib, Gentoo
# and Alpine <= 3.22 keep real directories.
# ---------------------------------------------------------------------------
EXPOSED_ROOTS=(/usr /etc)

covered_by_exposed_root() {
    local p="$1" r
    for r in "${EXPOSED_ROOTS[@]}"; do
        [[ "$p" == "$r" || "$p" == "$r"/* ]] && return 0
    done
    return 1
}

mirror_node() {
    local p="$1" target
    if [[ -L "$p" ]]; then
        BWRAP_ARGS+=(--symlink "$(readlink "$p")" "$p")
        # shortcut: canonical target; a link whose target path crosses another
        # symlinked directory needs that hop replicated manually
        target="$(readlink -f "$p" || true)"
        if [[ -e "$target" ]] && ! covered_by_exposed_root "$target"; then
            BWRAP_ARGS+=(--ro-bind "$target" "$target")
            EXPOSED_ROOTS+=("$target")
        fi
    elif [[ -e "$p" ]]; then
        BWRAP_ARGS+=(--ro-bind "$p" "$p")
    fi
}

# ---------------------------------------------------------------------------
# Build bwrap argument array
# bwrap flag order is significant: mounts stack left-to-right on a fresh tmpfs.
#
# base filesystem goes first
# ---------------------------------------------------------------------------
BWRAP_ARGS=(
    --unshare-all
    --share-net
    # cleanup runs from an EXIT trap, which SIGKILL skips; never outlive it
    --die-with-parent
    --dev /dev
    --proc /proc
    --ro-bind /usr /usr
    --ro-bind /etc /etc
)

# sandbox /tmp: a fresh host directory the user can inspect afterwards, or an
# empty tmpfs. Either way config mounts on /tmp stack on top of it.
if [[ "${SHARED_TEMP}" == true ]]; then
    SHARED_TMP="$(mktemp -d "${TMPDIR:-/tmp}/wrap-omp-tmp.XXXXXX")"
    echo "wrap-omp: shared /tmp: ${SHARED_TMP}" >&2
    if [[ "${SHARED_TEMP_CLEANUP}" == true ]]; then
        SHARED_TMP_CLEAN="${SHARED_TMP}"
    fi
    BWRAP_ARGS+=(--bind "${SHARED_TMP}" /tmp)
else
    BWRAP_ARGS+=(--dir /tmp)
fi

BWRAP_ARGS+=(--dir "${HOME}")

# /etc/resolv.conf is normally a link into /run (systemd-resolved, resolvconf,
# NetworkManager). The link arrives with /etc; only its target must be
# reachable, since bwrap refuses to mount over an existing symlink. A plain
# file needs nothing.
if [[ -L /etc/resolv.conf && -e /etc/resolv.conf ]]; then
    resolv="$(readlink -f /etc/resolv.conf)"
    covered_by_exposed_root "$resolv" ||
        BWRAP_ARGS+=(--ro-bind "$resolv" "$resolv")
fi

for node in /bin /sbin /lib /lib64 /lib32 /libx32; do
    mirror_node "$node"
done

# read-only home directories omp needs; mounted before the config mounts so a
# writeable_mounts entry can override one of them
for d in "${HOME}/.local" "${HOME}/.bun"; do
    if [[ -d "${d}" ]]; then
        BWRAP_ARGS+=(--ro-bind "${d}" "${d}")
    fi
done

# append mounts form config file
for mnt in "${EXTRA_RO_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--ro-bind "$mnt" "$mnt")
done

for mnt in "${EXTRA_BIND_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--bind "$mnt" "$mnt")
done

# a missing source here is silently skipped by bwrap
for mnt in "${TRY_RO_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--ro-bind-try "$mnt" "$mnt")
done

for mnt in "${TRY_BIND_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--bind-try "$mnt" "$mnt")
done

# --bind with device access, for paths holding device nodes (e.g. /dev/dri)
for mnt in "${DEV_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--dev-bind "$mnt" "$mnt")
done

# filtered D-Bus access: proxy runs on the host, only the socket is bound in
PROXY_SYSTEM=""
PROXY_SESSION=""

for bus in system session; do
    case "${bus}" in
        system)
            args=("${DBUS_SYSTEM_ARGS[@]}")
            addr="${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}"
            ;;
        session)
            args=("${DBUS_SESSION_ARGS[@]}")
            addr="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"
            ;;
    esac
    if [[ ${#args[@]} -eq 0 ]]; then
        continue
    fi
    start_dbus_proxy "${bus}" "${addr}" "${args[@]}"
    sock="${DBUS_PROXY_DIR}/${bus}"
    BWRAP_ARGS+=(--ro-bind "${sock}" "${sock}")
    if [[ "${bus}" == system ]]; then
        PROXY_SYSTEM="${sock}"
    else
        PROXY_SESSION="${sock}"
    fi
done

if [[ "${CLIP_BRIDGE}" == true ]]; then
    start_clip_broker
fi

# make sure the workspace and ~/.omp are accessible
# workspace first, then ~/.omp on top, so .omp stays writable inside a $HOME workspace
mkdir -p "${HOME}/.omp"

# only a workspace inside $HOME is exposed; $HOME itself and anything outside
# it stay unmounted and omp starts in the sandbox home
if [[ "${WORKDIR}" == "${HOME_REAL}"/* ]]; then
    BWRAP_ARGS+=(--bind "${WORKDIR}" "${WORKDIR}")
    SANDBOX_CWD="${WORKDIR}"
else
    SANDBOX_CWD="${HOME}"
    if [[ "${WORKDIR}" != "${HOME_REAL}" ]]; then
        echo "wrap-omp: warning: ${WORKDIR} is outside ${HOME}; workspace not mounted" >&2
    fi
fi

BWRAP_ARGS+=(--bind "${HOME}/.omp" "${HOME}/.omp")

# clipboard bridge: the clip dir holds the wl-paste shim and the broker socket;
# omp finds the shim through PATH and nothing else from the host is visible.
if [[ -n "${CLIP_DIR}" ]]; then
    BWRAP_ARGS+=(--ro-bind "${CLIP_DIR}" "${CLIP_DIR}")
fi

SANDBOX_PATH="${PATH}"
if [[ -n "${CLIP_DIR}" ]]; then
    SANDBOX_PATH="${CLIP_DIR}:${SANDBOX_PATH}"
fi

BWRAP_ARGS+=(
    --clearenv
    --setenv container "bwrap" # on Fedora this shows a dot in bash prompt signifying you're in sandbox.
    --setenv HOME "${HOME}"
    --setenv USER "${USER}"
    --setenv PATH "${SANDBOX_PATH}"
)

# host path behind the sandbox /tmp; omp-code remaps /tmp arguments with it
if [[ -n "${SHARED_TMP}" ]]; then
    BWRAP_ARGS+=(--setenv REALTEMP "${SHARED_TMP}")
fi

# append environment variables form config
for var in "${EXTRA_ENV_VARS[@]}"; do
    if [[ -v "${var}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    else
        echo "wrap-omp: warning: ${var} is not set in the environment, skipping" >&2
    fi
done

# literal variables from config; applied after pulled ones so they win
for pair in "${SET_ENV_PAIRS[@]}"; do
    BWRAP_ARGS+=(--setenv "${pair%%=*}" "${pair#*=}")
done

if [[ -n "${PROXY_SYSTEM}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SYSTEM_BUS_ADDRESS "unix:path=${PROXY_SYSTEM}")
fi
if [[ -n "${PROXY_SESSION}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=${PROXY_SESSION}")
fi

if [[ -n "${CLIP_DIR}" ]]; then
    BWRAP_ARGS+=(
        --setenv OMP_CLIP_BROKER "${CLIP_DIR}/broker.sock"
        --setenv WAYLAND_DISPLAY "omp-clip-broker" # non-empty only; omp gates its wl-paste path on it
    )
fi

BWRAP_ARGS+=(
    --chdir "${SANDBOX_CWD}"
    "${OMP_BIN}"
)

if [[ ${#DBUS_PROXY_PIDS[@]} -gt 0 || -n "${CLIP_DIR}" || -n "${SHARED_TMP_CLEAN}" ]]; then
    HELPER_PIDS=("${DBUS_PROXY_PIDS[@]}")
    if [[ -n "${CLIP_PID}" ]]; then
        HELPER_PIDS+=("${CLIP_PID}")
    fi
    start_watchdog
fi

# Run bwrap in the background: a trapped signal interrupts `wait` at once,
# while a foreground child would defer the trap until the sandbox exited on
# its own. cleanup() stops bwrap; --die-with-parent covers a SIGKILL of this
# script.
# `<&0` is required: a non-interactive shell points an async command's stdin
# at /dev/null, and omp is a terminal program.
bwrap "${BWRAP_ARGS[@]}" "$@" <&0 &
BWRAP_PID=$!
wait "${BWRAP_PID}"
