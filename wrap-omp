#!/usr/bin/env bash
# wrap-omp: run oh-my-pi inside a bubblewrap sandbox.
#
# Override the omp binary:
#   OMP_BIN=/path/to/omp ./omp-bwrap
#
# Optional config file (JSON with comments):
#   ~/.config/wrap-omp.conf   (preferred)
#   ~/wrap-omp.conf           (fallback)
#
# Config keys:
#   "env"                — extra env var names to pull from host into sandbox
#   "writeable_mounts"   — extra paths to --bind (read-write)
#   "read_only_mounts"   — extra paths to --ro-bind
#   "dbus"               — per-bus xdg-dbus-proxy policy args, e.g.
#                          {"system": ["--talk=org.bluez"]}; without an entry
#                          the sandbox has no access to that bus
#   "clipboard_bridge"   — true to serve image/png from the host Wayland
#                          clipboard through a read-only host-side broker
#                          (requires omp-clip-shim and omp-clip-broker next
#                          to this script; no Wayland socket enters the sandbox)

set -euo pipefail

OMP_BIN="${OMP_BIN:-omp}"
WORKDIR="${WORKDIR:-$(pwd)}"
WORKDIR="$(cd "$WORKDIR" && pwd -P)"
HOME_REAL="$(cd "${HOME}" && pwd -P)"

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------
if ! command -v bwrap &>/dev/null; then
    echo "wrap-omp: error: bubblewrap sandbox tool bwrap is required but not found on PATH" >&2
    exit 1
fi

if [[ ! -x "${OMP_BIN}" ]] && ! command -v "${OMP_BIN}" &>/dev/null; then
    echo "wrap-omp: error: ${OMP_BIN} not found or not executable" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Config file (optional) — extra mounts and env vars beyond the hardcoded set
# ---------------------------------------------------------------------------
EXTRA_ENV_VARS=()
EXTRA_BIND_MOUNTS=()
EXTRA_RO_MOUNTS=()
DBUS_SYSTEM_ARGS=()
DBUS_SESSION_ARGS=()
CLIP_BRIDGE=false

OMP_CONF=""
for dir in "${HOME}/.config" "${HOME}"; do
    if [[ -f "${dir}/wrap-omp.conf" ]]; then
        OMP_CONF="${dir}/wrap-omp.conf"
        break
    fi
done

if [[ -n "${OMP_CONF}" ]]; then
    if ! command -v jq &>/dev/null; then
        echo "wrap-omp: error: jq is required to parse ${OMP_CONF}" >&2
        exit 1
    fi

    # Strip // comments, then read every value in one jq pass as
    # "key<TAB>value<NUL>" records.
    # shortcut: "//" inside a string is stripped too, so values must not contain it
    CLEAN="$(sed 's|//.*$||' "${OMP_CONF}")"

    if ! printf '%s' "$CLEAN" | jq empty 2>/dev/null; then
        echo "wrap-omp: error: invalid JSON in ${OMP_CONF}" >&2
        exit 1
    fi

    while IFS=$'\t' read -r -d '' key val; do
        case "${key}" in
            env) EXTRA_ENV_VARS+=("${val}") ;;
            rw) EXTRA_BIND_MOUNTS+=("${val/#\~/$HOME}") ;;
            ro) EXTRA_RO_MOUNTS+=("${val/#\~/$HOME}") ;;
            dbus-system) DBUS_SYSTEM_ARGS+=("${val}") ;;
            dbus-session) DBUS_SESSION_ARGS+=("${val}") ;;
            clip) CLIP_BRIDGE=true ;;
        esac
    done < <(printf '%s' "$CLEAN" | jq -j '
        def emit($k): .[]? | select(. != "") | "\($k)\t\(.)\u0000";
        ((.env // []) | emit("env")),
        ((.writeable_mounts // []) | emit("rw")),
        ((.read_only_mounts // []) | emit("ro")),
        ((.dbus.system // []) | emit("dbus-system")),
        ((.dbus.session // []) | emit("dbus-session")),
        (if (.clipboard_bridge // false) == true then "clip\t\u0000" else empty end)
    ')
fi

# ---------------------------------------------------------------------------
# D-Bus proxies: one filtered xdg-dbus-proxy per configured bus, socket bound
# into the sandbox. Concurrent wrap-omp runs get separate mktemp dirs.
# ---------------------------------------------------------------------------
BWRAP_PID=""
DBUS_PROXY_DIR=""
DBUS_PROXY_PIDS=()
CLIP_DIR=""
CLIP_PID=""
CLIP_SHIM=""
CLIP_BROKER=""
CLIP_WL=""

cleanup() {
    local pid
    if [[ -n "${BWRAP_PID}" ]]; then
        kill "${BWRAP_PID}" 2>/dev/null || true
    fi
    for pid in "${DBUS_PROXY_PIDS[@]}"; do
        kill "${pid}" 2>/dev/null || true
    done
    if [[ -n "${CLIP_PID}" ]]; then
        kill "${CLIP_PID}" 2>/dev/null || true
    fi
    if [[ -n "${DBUS_PROXY_DIR}" ]]; then
        rm -rf "${DBUS_PROXY_DIR}"
    fi
    if [[ -n "${CLIP_DIR}" ]]; then
        rm -rf "${CLIP_DIR}"
    fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

wait_for_socket() {
    local sock="$1" pid="$2" what="$3"
    for _ in {1..100}; do
        [[ -S "${sock}" ]] && return 0
        if ! kill -0 "${pid}" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    echo "wrap-omp: error: ${what} failed to start" >&2
    exit 1
}

start_dbus_proxy() {
    local bus="$1" addr="$2" sock pid
    shift 2

    if [[ -z "${DBUS_PROXY_DIR}" ]]; then
        DBUS_PROXY_DIR="$(mktemp -d /tmp/wrap-omp-dbus.XXXXXX)"
    fi

    sock="${DBUS_PROXY_DIR}/${bus}"
    xdg-dbus-proxy "${addr}" "${sock}" --filter "$@" &
    pid="$!"
    DBUS_PROXY_PIDS+=("${pid}")

    wait_for_socket "${sock}" "${pid}" "dbus proxy for ${bus} bus (${addr})"
}

start_clip_broker() {
    local self_dir
    self_dir="$(dirname "$(readlink -f "$0")")"
    CLIP_SHIM="${self_dir}/omp-clip-shim"
    CLIP_BROKER="${self_dir}/omp-clip-broker"

    if ! command -v python3 &>/dev/null; then
        echo "wrap-omp: error: python3 is required for \"clipboard_bridge\"" >&2
        exit 1
    fi

    CLIP_WL="$(command -v wl-paste || true)"
    if [[ "${CLIP_WL}" != /* ]]; then
        echo "wrap-omp: error: \"clipboard_bridge\" requires wl-paste on PATH" >&2
        exit 1
    fi

    if [[ ! -x "${CLIP_SHIM}" || ! -f "${CLIP_BROKER}" ]]; then
        echo "wrap-omp: error: ${CLIP_SHIM} and ${CLIP_BROKER} must be installed next to wrap-omp" >&2
        exit 1
    fi

    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        echo "wrap-omp: warning: \"clipboard_bridge\" is enabled but the host has no WAYLAND_DISPLAY" >&2
    fi

    CLIP_DIR="$(mktemp -d /tmp/wrap-omp-clip.XXXXXX)"

    python3 "${CLIP_BROKER}" "${CLIP_DIR}/broker.sock" "${CLIP_WL}" &
    CLIP_PID=$!

    wait_for_socket "${CLIP_DIR}/broker.sock" "${CLIP_PID}" "clipboard broker"
}

if [[ ${#DBUS_SYSTEM_ARGS[@]} -gt 0 || ${#DBUS_SESSION_ARGS[@]} -gt 0 ]]; then
    if ! command -v xdg-dbus-proxy &>/dev/null; then
        echo "wrap-omp: error: xdg-dbus-proxy is required for \"dbus\" config but not found on PATH" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Host filesystem shape
# Don't hardcode Fedora's usr-merge flavor. Recreate what the host has: a
# top-level bin/sbin/lib/lib64 that is a symlink stays a symlink (its target
# lives under the already mounted /usr); a real split directory is bound
# read-only. Fedora maps /lib64 -> usr/lib64, Arch maps it to usr/lib, Gentoo
# and Alpine <= 3.22 keep real directories.
# ---------------------------------------------------------------------------
EXPOSED_ROOTS=(/usr /etc)

covered_by_exposed_root() {
    local p="$1" r
    for r in "${EXPOSED_ROOTS[@]}"; do
        [[ "$p" == "$r" || "$p" == "$r"/* ]] && return 0
    done
    return 1
}

mirror_node() {
    local p="$1" target
    if [[ -L "$p" ]]; then
        BWRAP_ARGS+=(--symlink "$(readlink "$p")" "$p")
        # shortcut: canonical target; a link whose target path crosses another
        # symlinked directory needs that hop replicated manually
        target="$(readlink -f "$p" || true)"
        if [[ -e "$target" ]] && ! covered_by_exposed_root "$target"; then
            BWRAP_ARGS+=(--ro-bind "$target" "$target")
            EXPOSED_ROOTS+=("$target")
        fi
    elif [[ -e "$p" ]]; then
        BWRAP_ARGS+=(--ro-bind "$p" "$p")
    fi
}

# ---------------------------------------------------------------------------
# Build bwrap argument array
# bwrap flag order is significant: mounts stack left-to-right on a fresh tmpfs.
#
# base filesystem goes first
# ---------------------------------------------------------------------------
BWRAP_ARGS=(
    --unshare-all
    --share-net
    # cleanup runs from an EXIT trap, which SIGKILL skips; never outlive it
    --die-with-parent
    --dev /dev
    --proc /proc
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --dir "/tmp"
    --dir "${HOME}"
)

# /etc/resolv.conf is normally a link into /run (systemd-resolved, resolvconf,
# NetworkManager). The link arrives with /etc; only its target must be
# reachable, since bwrap refuses to mount over an existing symlink. A plain
# file needs nothing.
if [[ -L /etc/resolv.conf && -e /etc/resolv.conf ]]; then
    resolv="$(readlink -f /etc/resolv.conf)"
    covered_by_exposed_root "$resolv" ||
        BWRAP_ARGS+=(--ro-bind "$resolv" "$resolv")
fi

for node in /bin /sbin /lib /lib64 /lib32 /libx32; do
    mirror_node "$node"
done

# read-only home directories omp needs; mounted before the config mounts so a
# writeable_mounts entry can override one of them
for d in "${HOME}/.local" "${HOME}/.bun"; do
    if [[ -d "${d}" ]]; then
        BWRAP_ARGS+=(--ro-bind "${d}" "${d}")
    fi
done

# append mounts form config file
for mnt in "${EXTRA_RO_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--ro-bind "$mnt" "$mnt")
done

for mnt in "${EXTRA_BIND_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--bind "$mnt" "$mnt")
done

# filtered D-Bus access: proxy runs on the host, only the socket is bound in
PROXY_SYSTEM=""
PROXY_SESSION=""

for bus in system session; do
    case "${bus}" in
        system)
            args=("${DBUS_SYSTEM_ARGS[@]}")
            addr="${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}"
            ;;
        session)
            args=("${DBUS_SESSION_ARGS[@]}")
            addr="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"
            ;;
    esac
    if [[ ${#args[@]} -eq 0 ]]; then
        continue
    fi
    start_dbus_proxy "${bus}" "${addr}" "${args[@]}"
    sock="${DBUS_PROXY_DIR}/${bus}"
    BWRAP_ARGS+=(--ro-bind "${sock}" "${sock}")
    if [[ "${bus}" == system ]]; then
        PROXY_SYSTEM="${sock}"
    else
        PROXY_SESSION="${sock}"
    fi
done

if [[ "${CLIP_BRIDGE}" == true ]]; then
    start_clip_broker
fi

# make sure the workspace and ~/.omp are accessible
# workspace first, then ~/.omp on top, so .omp stays writable inside a $HOME workspace
mkdir -p "${HOME}/.omp"

# only a workspace inside $HOME is exposed; $HOME itself and anything outside
# it stay unmounted and omp starts in the sandbox home
if [[ "${WORKDIR}" == "${HOME_REAL}"/* ]]; then
    BWRAP_ARGS+=(--bind "${WORKDIR}" "${WORKDIR}")
    SANDBOX_CWD="${WORKDIR}"
else
    SANDBOX_CWD="${HOME}"
    if [[ "${WORKDIR}" != "${HOME_REAL}" ]]; then
        echo "wrap-omp: warning: ${WORKDIR} is outside ${HOME}; workspace not mounted" >&2
    fi
fi

BWRAP_ARGS+=(--bind "${HOME}/.omp" "${HOME}/.omp")

# clipboard bridge: shim replaces wl-paste, socket dir is the only host object
# visible to it. Mounted last so no earlier mount can shadow the shim.
if [[ -n "${CLIP_DIR}" ]]; then
    BWRAP_ARGS+=(
        --ro-bind "${CLIP_SHIM}" "${CLIP_WL}"
        --ro-bind "${CLIP_DIR}" "${CLIP_DIR}"
    )
fi

BWRAP_ARGS+=(
    --clearenv
    --setenv container "bwrap" # on Fedora this shows a dot in bash prompt signifying you're in sandbox.
    --setenv HOME "${HOME}"
    --setenv USER "${USER}"
    --setenv PATH "${PATH}"
)

# append environment variables form config
for var in "${EXTRA_ENV_VARS[@]}"; do
    if [[ -v "${var}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    else
        echo "wrap-omp: warning: ${var} is not set in the environment, skipping" >&2
    fi
done

if [[ -n "${PROXY_SYSTEM}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SYSTEM_BUS_ADDRESS "unix:path=${PROXY_SYSTEM}")
fi
if [[ -n "${PROXY_SESSION}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=${PROXY_SESSION}")
fi

if [[ -n "${CLIP_DIR}" ]]; then
    BWRAP_ARGS+=(
        --setenv OMP_CLIP_BROKER "${CLIP_DIR}/broker.sock"
        --setenv WAYLAND_DISPLAY "omp-clip-broker" # non-empty only; omp gates its wl-paste path on it
    )
fi

BWRAP_ARGS+=(
    --chdir "${SANDBOX_CWD}"
    "${OMP_BIN}"
)

# Run bwrap in the background: a trapped signal interrupts `wait` at once,
# while a foreground child would defer the trap until the sandbox exited on
# its own. cleanup() stops bwrap; --die-with-parent covers a SIGKILL of this
# script.
bwrap "${BWRAP_ARGS[@]}" "$@" &
BWRAP_PID=$!
wait "${BWRAP_PID}"
