#!/usr/bin/env bash
# wrap-omp: run oh-my-pi inside a bubblewrap sandbox.
#
# Override the omp binary:
#   OMP_BIN=/path/to/omp ./omp-bwrap
#
# Optional config file (JSON with comments):
#   ~/.config/wrap-omp.conf   (preferred)
#   ~/wrap-omp.conf           (fallback)
#
# Config keys:
#   "env"                — extra env var names to pull from host into sandbox
#   "writeable_mounts"   — extra paths to --bind (read-write)
#   "read_only_mounts"   — extra paths to --ro-bind
#   "dbus"               — per-bus xdg-dbus-proxy policy args, e.g.
#                          {"system": ["--talk=org.bluez"]}; without an entry
#                          the sandbox has no access to that bus

set -euo pipefail

OMP_BIN="${OMP_BIN:-omp}"
WORKDIR="${WORKDIR:-$(pwd)}"
WORKDIR="$(cd "$WORKDIR" && pwd -P)"

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------
if ! command -v bwrap &>/dev/null; then
    echo "wrap-omp: error: bubblewrap sandbox tool bwrap is required but not found on PATH" >&2
    exit 1
fi

if [[ ! -x "${OMP_BIN}" ]] && ! command -v "${OMP_BIN}" &>/dev/null; then
    echo "wrap-omp: error: ${OMP_BIN} not found or not executable" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Config file (optional) — extra mounts and env vars beyond the hardcoded set
# ---------------------------------------------------------------------------
EXTRA_ENV_VARS=()
EXTRA_BIND_MOUNTS=()
EXTRA_RO_MOUNTS=()
DBUS_SYSTEM_ARGS=()
DBUS_SESSION_ARGS=()

OMP_CONF=""
for dir in "${HOME}/.config" "${HOME}"; do
    if [[ -f "${dir}/wrap-omp.conf" ]]; then
        OMP_CONF="${dir}/wrap-omp.conf"
        break
    fi
done

if [[ -n "${OMP_CONF}" ]]; then
    if ! command -v jq &>/dev/null; then
        echo "wrap-omp: error: jq is required to parse ${OMP_CONF}" >&2
        exit 1
    fi

    # Strip // comments, then extract arrays with jq
    CLEAN="$(sed 's|//.*$||' "${OMP_CONF}")"

    while IFS= read -r var; do
        [[ -n "$var" ]] && EXTRA_ENV_VARS+=("$var")
    done < <(echo "$CLEAN" | jq -r '.env[]? // empty')

    while IFS= read -r p; do
        [[ -n "$p" ]] && EXTRA_BIND_MOUNTS+=("${p/#\~/$HOME}")
    done < <(echo "$CLEAN" | jq -r '.writeable_mounts[]? // empty')

    while IFS= read -r p; do
        [[ -n "$p" ]] && EXTRA_RO_MOUNTS+=("${p/#\~/$HOME}")
    done < <(echo "$CLEAN" | jq -r '.read_only_mounts[]? // empty')

    while IFS= read -r a; do
        [[ -n "$a" ]] && DBUS_SYSTEM_ARGS+=("$a")
    done < <(echo "$CLEAN" | jq -r '.dbus.system[]? // empty')

    while IFS= read -r a; do
        [[ -n "$a" ]] && DBUS_SESSION_ARGS+=("$a")
    done < <(echo "$CLEAN" | jq -r '.dbus.session[]? // empty')
fi

# ---------------------------------------------------------------------------
# D-Bus proxies: one filtered xdg-dbus-proxy per configured bus, socket bound
# into the sandbox. Concurrent wrap-omp runs get separate mktemp dirs.
# ---------------------------------------------------------------------------
DBUS_PROXY_DIR=""
DBUS_PROXY_PIDS=()

cleanup() {
    local pid
    for pid in "${DBUS_PROXY_PIDS[@]}"; do
        kill "${pid}" 2>/dev/null || true
    done
    if [[ -n "${DBUS_PROXY_DIR}" ]]; then
        rm -rf "${DBUS_PROXY_DIR}"
    fi
}

start_dbus_proxy() {
    local bus="$1" addr="$2" sock pid
    shift 2

    if [[ -z "${DBUS_PROXY_DIR}" ]]; then
        DBUS_PROXY_DIR="$(mktemp -d /tmp/wrap-omp-dbus.XXXXXX)"
        trap cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM HUP
    fi

    sock="${DBUS_PROXY_DIR}/${bus}"
    xdg-dbus-proxy "${addr}" "${sock}" --filter "$@" &
    pid="$!"
    DBUS_PROXY_PIDS+=("${pid}")

    for _ in {1..100}; do
        [[ -S "${sock}" ]] && return 0
        if ! kill -0 "${pid}" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    echo "wrap-omp: error: dbus proxy for ${bus} bus failed to start (${addr})" >&2
    exit 1
}

if [[ ${#DBUS_SYSTEM_ARGS[@]} -gt 0 || ${#DBUS_SESSION_ARGS[@]} -gt 0 ]]; then
    if ! command -v xdg-dbus-proxy &>/dev/null; then
        echo "wrap-omp: error: xdg-dbus-proxy is required for \"dbus\" config but not found on PATH" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Build bwrap argument array
# bwrap flag order is significant: mounts stack left-to-right on a fresh tmpfs.
#
# base filesystem goes first
# ---------------------------------------------------------------------------
BWRAP_ARGS=(
    --unshare-all
    --share-net
    --dev /dev
    --proc /proc
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /run/systemd/resolve/stub-resolv.conf /run/systemd/resolve/stub-resolv.conf
    --symlink usr/bin /bin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --symlink usr/sbin /sbin
    --dir "/tmp"
    --dir "${HOME}"
)

# append mounts form config file
for mnt in "${EXTRA_RO_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--ro-bind "$mnt" "$mnt")
done

for mnt in "${EXTRA_BIND_MOUNTS[@]}"; do
    BWRAP_ARGS+=(--bind "$mnt" "$mnt")
done

# filtered D-Bus access: proxy runs on the host, only the socket is bound in
PROXY_SYSTEM=""
PROXY_SESSION=""

if [[ ${#DBUS_SYSTEM_ARGS[@]} -gt 0 ]]; then
    start_dbus_proxy system \
        "${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}" \
        "${DBUS_SYSTEM_ARGS[@]}"
    PROXY_SYSTEM="${DBUS_PROXY_DIR}/system"
    BWRAP_ARGS+=(--ro-bind "${PROXY_SYSTEM}" "${PROXY_SYSTEM}")
fi

if [[ ${#DBUS_SESSION_ARGS[@]} -gt 0 ]]; then
    start_dbus_proxy session \
        "${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}" \
        "${DBUS_SESSION_ARGS[@]}"
    PROXY_SESSION="${DBUS_PROXY_DIR}/session"
    BWRAP_ARGS+=(--ro-bind "${PROXY_SESSION}" "${PROXY_SESSION}")
fi

# make sure workspace and paths needed by omp are accessible
# workspace first, then ~/.omp on top, so .omp stays writable inside a $HOME workspace
BWRAP_ARGS+=(
    --ro-bind "${HOME}/.local" "${HOME}/.local"
    --ro-bind "${HOME}/.bun" "${HOME}/.bun"
)

# homedir special case: expose only files explicitly mounted in config file
# $HOME is writeable but uses tmpfs overlaid with actual files
if [[ "${WORKDIR}" != "${HOME}" ]]; then
    BWRAP_ARGS+=(--bind "${WORKDIR}" "${WORKDIR}")
fi

BWRAP_ARGS+=(--bind "${HOME}/.omp" "${HOME}/.omp")

BWRAP_ARGS+=(
    --clearenv
    --setenv container "bwrap" # on Fedora this shows a dot in bash prompt signifying you're in sandbox.
    --setenv HOME "${HOME}"
    --setenv USER "${USER}"
    --setenv PATH "${PATH}"
)

# append environment variables form config
for var in "${EXTRA_ENV_VARS[@]}"; do
    if [[ -v "${var}" ]]; then
        BWRAP_ARGS+=(--setenv "$var" "${!var}")
    else
        echo "wrap-omp: warning: ${var} is not set in the environment, skipping" >&2
    fi
done

if [[ -n "${PROXY_SYSTEM}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SYSTEM_BUS_ADDRESS "unix:path=${PROXY_SYSTEM}")
fi
if [[ -n "${PROXY_SESSION}" ]]; then
    BWRAP_ARGS+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=${PROXY_SESSION}")
fi

BWRAP_ARGS+=(
    --chdir "${WORKDIR}"
    "${OMP_BIN}"
)

# no exec: the EXIT trap kills the dbus proxies and removes their socket dir
bwrap "${BWRAP_ARGS[@]}" "$@"
