{
    // wrap-omp config. Install as ~/.config/wrap-omp.conf
    // host environment variables to pass into sandbox (good for API keys)
    "env": [
        "SOME_API_KEY"
    ],
    // variables set inside the sandbox with these literal values. Nothing is
    // read from the host, so the host environment stays unchanged. Use this
    // for switches only the sandboxed program should see, e.g. to keep omp
    // from writing into a read-only-mounted host home. Accepts strings,
    // numbers and booleans; entries with a null value are ignored.
    "set_env": {
        // "VARIABLE_NAME": "value"
    },
    // host paths that will be mounted read only in sandbox. Entries may use
    // a simple '*' glob; a pattern matching nothing mounts nothing.
    "read_only_mounts": [
        "~/my_git_repos",
        "~/.gitconfig"
    ],
    // host paths that will be present and writeable in sandbox
    // workspace folder is writeable by default
    "writeable_mounts": [
        "~/some_writeable_dir"
    ],
    // same as above, but a path that does not exist is skipped silently
    "try_mount_read_only": [],
    "try_mount_writeable": [],
    // host paths mounted writeable with --dev-bind, so device nodes inside
    // them stay usable (e.g. /dev/dri for GPU access)
    "dev_mounts": [],
    // filtered D-Bus access through xdg-dbus-proxy. Nothing is exposed by
    // default: a bus is reachable from the sandbox only if its list is
    // non-empty. The proxy runs on the host and only its socket is mounted in;
    // the sandbox never sees the real bus socket.
    // Each bus maps to policies passed to xdg-dbus-proxy:
    //   system  -> /run/dbus/system_bus_socket
    //   session -> $DBUS_SESSION_BUS_ADDRESS or $XDG_RUNTIME_DIR/bus
    // Policies (repeatable):
    //   --see=NAME             name visible (ListNames, GetNameOwner, ...)
    //   --talk=NAME            call methods, receive signals, start service
    //   --own=NAME             RequestName/ReleaseName on NAME
    //   --call=NAME=RULE       restrict calls: [METHOD][@PATH]
    //   --broadcast=NAME=RULE  restrict received broadcast signals
    // RULE supports '*' and path suffixes '/*'; NAME supports '.*'.
    // BLE via BlueZ (bleak/ble-mcp) needs system bus: ["--talk=org.bluez"].
    "dbus": {
        "system": [],
        "session": []
    },
    // image clipboard bridge: serve image/png from the host clipboard through
    // a read-only host-side broker. Wayland hosts need wl-clipboard; WSL hosts
    // use powershell.exe on the host, so the sandbox needs no /mnt/c or
    // /run/WSL mount. Clipboard text is never exposed. Requires omp-clip-shim
    // and omp-clip-broker installed next to wrap-omp.
    "clipboard_bridge": false,
    // back the sandbox /tmp with a fresh directory under the host /tmp
    // (named on stderr at startup) instead of an empty tmpfs, so the host can
    // inspect what the sandbox wrote. Mounts on /tmp still stack on top.
    // The directory's host path is exported to the sandbox as REALTEMP.
    "shared_temp": false,
    // delete that directory when the sandbox exits instead of keeping it
    "shared_temp_cleanup": false
}